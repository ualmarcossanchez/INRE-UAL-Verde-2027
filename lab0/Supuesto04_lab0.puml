@startuml
left to right direction

' Definición de Actores
actor "Gestor de la aplicación" as gestor
actor "Administrador" as admin
actor "Cliente" as cliente
actor "Vendedor" as vendedor
actor "Controlador de fotos" as controlador
actor "Software de facturación" as soft_facturacion
actor "Gestor de correo" as gestor_correo

' Relaciones de herencia (Generalización)
admin -up-|> gestor

' Definición de Casos de Uso y Relaciones

' Casos de uso de Cliente
usecase "Visualizar fotos\n----\nExtension points\nDenunciar foto" as visualizar_fotos
usecase "Consultar foto" as consultar_foto
usecase "Denunciar foto" as denunciar_foto
usecase "Explicar denuncia" as explicar_denuncia
usecase "Ver ofertas (cliente)" as ver_ofertas_cliente

cliente -- visualizar_fotos
cliente -- consultar_foto
cliente -- ver_ofertas_cliente
consultar_foto -up-|> visualizar_fotos
denunciar_foto ..> visualizar_fotos : <<extend>>
denunciar_foto ..> explicar_denuncia : <<include>>

' Casos de uso de Controlador de fotos
usecase "Indicar foto a revisar" as indicar_foto
usecase "Editar info fotos" as editar_info_fotos

controlador -- indicar_foto
controlador -- editar_info_fotos
denunciar_foto -up-|> indicar_foto

' Casos de uso de Vendedor
usecase "Hacer oferta\n----\nExtension points\nReducir precio" as hacer_oferta
usecase "Reducir precio" as reducir_precio
usecase "Buscar detalles" as buscar_detalles
usecase "Verificar datos" as verificar_datos

vendedor -- hacer_oferta
vendedor -- buscar_detalles
reducir_precio ..> hacer_oferta : <<extend>>
buscar_detalles -up-|> visualizar_fotos
buscar_detalles ..> verificar_datos : <<include>>

' Casos de uso de Gestor de la aplicación
usecase "Ver ofertas" as ver_ofertas
usecase "Bloquear ofertas" as bloquear_ofertas
usecase "Emitir facturas" as emitir_facturas
usecase "Editar facturas" as editar_facturas
usecase "Editar datos" as editar_datos

gestor -- ver_ofertas
gestor -- bloquear_ofertas
gestor -- emitir_facturas
gestor -- editar_facturas
ver_ofertas_cliente -up-|> ver_ofertas
emitir_facturas -up-|> editar_datos
emitir_facturas -- soft_facturacion

' Casos de uso de Administrador
usecase "Crear usuarios" as crear_usuarios
usecase "Editar usuarios" as editar_usuarios
usecase "Enviar email" as enviar_email

admin -- crear_usuarios
admin -- editar_usuarios
editar_usuarios -up-|> editar_datos
crear_usuarios ..> enviar_email : <<include>>
enviar_email -- gestor_correo

@enduml
