@startuml Sistema_de_Gestion_de_Incidencias

top to bottom direction

' ==========================================
' ACTORES
' ==========================================
actor "Usuario Invitado" as UsuarioInvitado
actor "Empleado" as Empleado
actor "Administrador" as Administrador
actor "Técnico" as Tecnico
actor "Operador" as Operador
actor "Empleado menor" as EmpleadoMenor
actor "Sistema de Gestión de Correo" as SistemaCorreo << System >>

' Alineación de actores
UsuarioInvitado -[hidden]down-> Empleado
Empleado -[hidden]down-> Tecnico
Tecnico -[hidden]down-> EmpleadoMenor

Administrador -[hidden]down-> Operador
Operador -[hidden]down-> SistemaCorreo

' Herencia entre actores
Administrador --|> Empleado
Tecnico --|> Empleado
Operador --|> Empleado
Tecnico --|> EmpleadoMenor
Operador --|> EmpleadoMenor

' ==========================================
' SISTEMA Y CASOS DE USO
' ==========================================
rectangle "Sistema de Gestión de Incidencias" {

    ' --- Fila 1: Alta de datos de incidencia ---
    usecase "Dar de alta localización\nen un mapa" as UC_Mapa
    usecase "Explicación completa\nFormato textual" as UC_Texto
    usecase "Subir foto" as UC_Foto
    usecase "Adición de comentario" as UC_AdicionComentario

    ' --- Fila 2: Casos de Uso Principales de usuario y admin ---
    usecase "Informar sobre\nposible incidencia" as UC_Informar
    usecase "Registrarse" as UC_Registrarse
    usecase "Gestionar categoría\nincidencia" as UC_GestionarCat
    usecase "Ordenar incidencia\nadministrador" as UC_OrdenarAdmin

    ' --- Fila 3: Consultas y Notificaciones ---
    usecase "Ver notificaciones" as UC_Notificaciones
    usecase "Acceder histórico\nnotificaciones" as UC_Historico
    usecase "Consultar incidencia\nusuario" as UC_ConsultarUsuario
    usecase "Consultar incidencia\n--\n<<Extend point>>\nEdición datos incidencia" as UC_Consultar
    usecase "Edición datos\nincidencia" as UC_Edicion

    ' --- Fila 4: Atención Telefónica e Informes ---
    usecase "Realizar informe\nde incidencias" as UC_Informe
    usecase "Atender llamada\ntelefónica" as UC_AtenderLlamada
    usecase "Comprobar dato\nde incidencia" as UC_ComprobarDato
    usecase "Atender llamada\ntelefónica técnico\n--\n<<Extend point>>\nComprobar dato de incidencia" as UC_AtenderLlamadaTecnico
    usecase "Atender llamada\ntelefónica operador" as UC_AtenderLlamadaOperador
    usecase "Introducir nuevo dato\nde incidencia" as UC_IntroducirDato

    ' --- Fila 5: Operaciones Operador y Envíos ---
    usecase "Ordenar incidencia" as UC_Ordenar
    usecase "Marcar incidencia\nduplicada" as UC_MarcarDuplicada
    usecase "Dar de alta\nincidencia\n--\n<<Extend point>>\nEnviar correo" as UC_AltaIncidencia
    usecase "Enviar correo" as UC_EnviarCorreo

    ' --- Enlaces ocultos para estructurar la rejilla interna ---
    UC_Mapa -[hidden]right- UC_Texto
    UC_Texto -[hidden]right- UC_Foto
    UC_Informar -[hidden]down- UC_Notificaciones
    UC_Notificaciones -[hidden]down- UC_AtenderLlamadaTecnico
    UC_AtenderLlamadaTecnico -[hidden]down- UC_AltaIncidencia
    UC_OrdenarAdmin -[hidden]down- UC_Ordenar
}

' ==========================================
' RELACIONES
' ==========================================

' Usuario Invitado
UsuarioInvitado -- UC_Informar
UsuarioInvitado -- UC_Notificaciones
UsuarioInvitado -- UC_Historico
UsuarioInvitado -- UC_ConsultarUsuario

' Inclusiones desde Informar sobre posible incidencia
UC_Informar .up.> UC_Mapa : <<include>>
UC_Informar .up.> UC_Texto : <<include>>
UC_Informar .up.> UC_Foto : <<include>>
UC_Informar .right.> UC_Registrarse : <<include>>
UC_Notificaciones .right.> UC_Registrarse : <<include>>

' Empleado y Administrador
Empleado -- UC_Consultar
UC_Edicion .right.> UC_Consultar : <<extend>>

Administrador -- UC_GestionarCat
Administrador -- UC_OrdenarAdmin
UC_OrdenarAdmin .up.> UC_AdicionComentario : <<include>>
UC_OrdenarAdmin --|> UC_Ordenar

' Operador
Operador -- UC_Ordenar
Operador -- UC_MarcarDuplicada
Operador -- UC_AtenderLlamadaOperador

' Técnico
Tecnico -- UC_Informe
Tecnico -- UC_AtenderLlamadaTecnico

' Especialización de llamadas telefónicas e Inclusiones/Extensiones
UC_AtenderLlamadaTecnico --|> UC_AtenderLlamada
UC_AtenderLlamadaOperador --|> UC_AtenderLlamada
UC_ComprobarDato .right.> UC_AtenderLlamadaTecnico : <<extend>>
UC_AtenderLlamadaOperador .down.> UC_IntroducirDato : <<include>>

' Empleado menor y Sistema Externo
EmpleadoMenor -- UC_AltaIncidencia
UC_EnviarCorreo .left.> UC_AltaIncidencia : <<extend>>
UC_EnviarCorreo -- SistemaCorreo

@enduml
