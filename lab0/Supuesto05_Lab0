@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam actor {
    BackgroundColor #E2EFDA
    BorderColor #385723
}
skinparam usecase {
    BackgroundColor #F2F2F2
    BorderColor #595959
}

' --- ACTORES IZQUIERDA ---
actor "Usuario\nInvitado" as UsuarioInvitado
actor "Empleado" as Empleado
actor "Administrador" as Administrador
actor "Técnico" as Tecnico
actor "Operador" as Operador
actor "Empleado\nmenor" as EmpleadoMenor

' --- ACTOR DERECHA ---
actor "Sistema de Gestión\nde Correo" as SistemaCorreo <<System>>

' --- HERENCIA DE ACTORES ---
Administrador --|> Empleado
Tecnico --|> Empleado
Operador --|> Empleado

Tecnico --|> EmpleadoMenor
Operador --|> EmpleadoMenor

' --- SISTEMA PRINCIPAL ---
rectangle "Sistema de Gestión de Incidencias" {

    ' Bloque Usuario Invitado
    usecase "Informar sobre\nposible incidencia" as UC_Informar
    usecase "Dar de alta localización\nen un mapa" as UC_DarAltaMap
    usecase "Explicación completa\nFormato textual" as UC_Explicacion
    usecase "Subida foto" as UC_SubidaFoto
    usecase "Registrarse" as UC_Registrarse
    usecase "Ver notificaciones" as UC_VerNotif
    usecase "Acceder histórico\nnotificaciones" as UC_AccederHist
    usecase "Consultar incidencia\nusuario" as UC_ConsultarUsuario

    ' Bloque Consultas y Edición (Empleado)
    usecase "Consultar incidencia\n--\n<<Extend point>>\nEdición datos incidencia" as UC_ConsultarIncidencia
    usecase "Edición datos\nincidencia" as UC_EdicionDatos

    ' Bloque Atención Telefónica
    usecase "Atender llamada\ntelefónica" as UC_AtenderLlamada
    usecase "Atender llamada\ntelefónica técnico\n--\n<<Extend point>>\nComprobar dato de incidencia" as UC_AtenderTecnico
    usecase "Atender llamada\ntelefónica operador" as UC_AtenderOperador
    usecase "Comprobar dato\nde incidencia" as UC_ComprobarDato
    usecase "Introducir nuevo dato\nde incidencia" as UC_IntroducirDato

    ' Bloque Administrador / Técnico / Operador
    usecase "Gestionar categoría\nincidencia" as UC_GestionarCat
    usecase "Ordenar incidencia\nadministrador" as UC_OrdenarAdmin
    usecase "Adición de comentario" as UC_AdicionComentario
    usecase "Ordenar incidencia" as UC_Ordenar
    usecase "Realizar informe\nde incidencias" as UC_RealizarInforme
    usecase "Marcar incidencia\nduplicada" as UC_MarcarDup

    ' Bloque Empleado Menor y Correo
    usecase "Dar de alta\nincidencia\n--\n<<Extend point>>\nEnviar correo" as UC_DarAltaIncidencia
    usecase "Enviar correo" as UC_EnviarCorreo
}

' --- RELACIONES Y ALINEACIÓN ---

' Usuario Invitado
UsuarioInvitado --> UC_Informar
UsuarioInvitado --> UC_VerNotif
UsuarioInvitado --> UC_AccederHist
UsuarioInvitado --> UC_ConsultarUsuario

UC_DarAltaMap .down.> UC_Informar : <<extend>>
UC_Explicacion .down.> UC_Informar : <<extend>>
UC_SubidaFoto .down.> UC_Informar : <<extend>>
UC_Informar .right.> UC_Registrarse : <<include>>

' Empleado
Empleado --> UC_ConsultarIncidencia
Empleado --> UC_AtenderLlamada
UC_EdicionDatos .left.> UC_ConsultarIncidencia : <<extend>>

' Atención telefónica (Herencia y extensiones)
UC_AtenderLlamada <|-- UC_AtenderTecnico
UC_AtenderLlamada <|-- UC_AtenderOperador
UC_ComprobarDato .left.> UC_AtenderTecnico : <<extend>>
UC_IntroducirDato .left.> UC_AtenderOperador : <<include>>

' Administrador
Administrador --> UC_GestionarCat
Administrador --> UC_OrdenarAdmin
UC_AdicionComentario .left.> UC_OrdenarAdmin : <<extend>>
UC_OrdenarAdmin --> UC_Ordenar

' Técnico y Operador
Tecnico --> UC_RealizarInforme
Operador --> UC_Ordenar
Operador --> UC_MarcarDup

' Empleado Menor y Correo Externo
EmpleadoMenor --> UC_DarAltaIncidencia
UC_EnviarCorreo .left.> UC_DarAltaIncidencia : <<extend>>
UC_EnviarCorreo --> SistemaCorreo
@enduml
