@startuml
left to right direction

abstract class Usuario {
  #idUsuario: String
  #nombre: String
  #email: String
}

class Cliente {
  +visualizarFotos(): Foto[]
  +consultarFotos(criterio: String): Foto[]
  +denunciarFoto(foto: Foto, explicacion: String): Denuncia
  +verOfertas(): Oferta[]
}

class Vendedor {
  +hacerOferta(cliente: Cliente, producto: Producto, precio: Double): Oferta
  +reducirPrecio(oferta: Oferta, nuevoPrecio: Double): void
  +buscarDetalles(criterio: String): Foto[]
  +verificarDatos(criterio: String): Boolean
}

class ControladorFotos {
  +indicarFotoARevisar(foto: Foto): void
  +editarInfoFoto(foto: Foto, informacion: String): void
}

class Gestor {
  +verOfertas(): Oferta[]
  +bloquearOferta(oferta: Oferta): void
  +emitirFactura(datos: Factura): Factura
  +editarFactura(factura: Factura, datos: Factura): void
}

class Administrador {
  +crearUsuario(datos: Usuario): Usuario
  +editarUsuario(usuario: Usuario, datos: Usuario): void
}

class Foto {
  -idFoto: String
  -titulo: String
  -informacion: String
  -estado: String
  +marcarPendienteRevision(): void
}

class Denuncia {
  -idDenuncia: String
  -explicacion: String
  -fecha: Date
}

class Producto {
  -idProducto: String
  -nombre: String
  -precio: Double
}

class Oferta {
  -idOferta: String
  -precio: Double
  -fecha: Date
  -bloqueada: Boolean
  +bloquear(): void
  +aplicarPrecioReducido(nuevoPrecio: Double): void
}

class Factura {
  -idFactura: String
  -fechaEmision: Date
  -importe: Double
  -datosFiscales: String
}

class SoftwareFacturacion {
  +generarFactura(datos: Factura): Factura
}

class GestorCorreo {
  +enviarEmail(destinatario: String, asunto: String, cuerpo: String): Boolean
}

Usuario <|-- Cliente
Usuario <|-- Vendedor
Usuario <|-- ControladorFotos
Usuario <|-- Gestor
Gestor <|-- Administrador

Cliente "1" --> "0..*" Denuncia : realiza
Denuncia "0..*" --> "1" Foto : sobre
ControladorFotos "1" --> "0..*" Foto : revisa
Vendedor "1" --> "0..*" Oferta : hace
Oferta "0..*" --> "1" Cliente : dirigida a
Oferta "0..*" --> "1" Producto : sobre
Gestor "1" --> "0..*" Oferta : gestiona
Gestor "1" --> "0..*" Factura : emite
Gestor ..> SoftwareFacturacion : emite mediante
Administrador "1" --> "0..*" Usuario : crea y edita
Administrador ..> GestorCorreo : notifica con
@enduml
