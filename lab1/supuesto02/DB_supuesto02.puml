@startuml

left to right direction

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle

title Diagrama de clases - Sistema de Compras


' =========================================================
' USUARIOS Y ROLES
' =========================================================

package "Gestión de usuarios" {

    class Usuario {
        - idUsuario: int <<PK>>
        - nombre: String
        - email: String
        - passwordHash: String
        - fechaRegistro: DateTime
        - activo: Boolean
    }

    class Rol {
        - idRol: int <<PK>>
        - nombre: String
    }

    class UsuarioRol {
        - idUsuario: int <<PK, FK>>
        - idRol: int <<PK, FK>>
    }
}


' =========================================================
' PRODUCTOS Y OFERTAS
' =========================================================

package "Catálogo de productos" {

    class Producto {
        - idProducto: int <<PK>>
        - idVendedor: int <<FK>>
        - nombre: String
        - descripcion: String
        - precioBase: double
        - cantidadDisponible: int
        - estado: EstadoProducto
        - fechaAlta: DateTime
    }

    enum EstadoProducto {
        ACTIVO
        BLOQUEADO
        ELIMINADO
    }

    class Oferta {
        - idOferta: int <<PK>>
        - idProducto: int <<FK>>
        - idPublicador: int <<FK>>
        - precioOferta: double
        - fechaInicio: DateTime
        - fechaFin: DateTime
        - estado: EstadoOferta
    }

    enum EstadoOferta {
        PENDIENTE
        ACTIVA
        FINALIZADA
        CANCELADA
        ELIMINADA
    }
}


' =========================================================
' CARRITO
' =========================================================

package "Gestión del carrito" {

    class Carrito {
        - idCarrito: int <<PK>>
        - idComprador: int <<FK>>
        - fechaCreacion: DateTime
        - estado: EstadoCarrito
    }

    enum EstadoCarrito {
        ACTIVO
        CONFIRMADO
        CANCELADO
    }

    class LineaCarrito {
        - idLinea: int <<PK>>
        - idCarrito: int <<FK>>
        - idProducto: int <<FK>>
        - idOferta: int <<FK>> {nullable}
        - cantidad: int
        - fechaAgregacion: DateTime
    }
}


' =========================================================
' COMPRAVENTAS
' =========================================================

package "Gestión de compraventas" {

    class Compraventa {
        - idCompraventa: int <<PK>>
        - idComprador: int <<FK>>
        - idVendedor: int <<FK>>
        - fecha: DateTime
        - estado: EstadoCompraventa
        - importeTotal: double
    }

    enum EstadoCompraventa {
        PENDIENTE
        ACEPTADA
        RECHAZADA
        CANCELADA
        COMPLETADA
    }

    class DetalleCompraventa {
        - idDetalle: int <<PK>>
        - idCompraventa: int <<FK>>
        - idProducto: int <<FK>>
        - idOferta: int <<FK>> {nullable}
        - cantidad: int
        - precioUnitarioFinal: double
    }
}


' =========================================================
' NOTIFICACIONES
' =========================================================

package "Gestión de notificaciones" {

    class Notificacion {
        - idNotificacion: int <<PK>>
        - idDestinatario: int <<FK>>
        - idEmisor: int <<FK>> {nullable}
        - idProducto: int <<FK>> {nullable}
        - idOferta: int <<FK>> {nullable}
        - titulo: String
        - mensaje: String
        - tipo: TipoNotificacion
        - fechaCreacion: DateTime
        - fechaLectura: DateTime {nullable}
        - leida: Boolean
    }

    enum TipoNotificacion {
        NUEVO_PRODUCTO
        NUEVA_OFERTA
        FIN_OFERTA
        OFERTA_ELIMINADA
        COMPRAVENTA
        SISTEMA
    }
}


' =========================================================
' RELACIONES DE USUARIOS Y ROLES
' =========================================================

Usuario "1" -- "0..*" UsuarioRol : idUsuario
Rol "1" -- "0..*" UsuarioRol : idRol


' =========================================================
' RELACIONES DE PRODUCTOS Y OFERTAS
' =========================================================

Usuario "1" -- "0..*" Producto : vendedor

Producto "1" -- "0..*" Oferta : tiene

Usuario "1" -- "0..*" Oferta : publica


' =========================================================
' RELACIONES DEL CARRITO
' =========================================================

Usuario "1" -- "0..*" Carrito : comprador

Carrito "1" *-- "0..*" LineaCarrito : contiene

Producto "1" -- "0..*" LineaCarrito : producto

Oferta "0..1" -- "0..*" LineaCarrito : oferta aplicada


' =========================================================
' RELACIONES DE COMPRAVENTA
' =========================================================

Usuario "1" -- "0..*" Compraventa : comprador

Usuario "1" -- "0..*" Compraventa : vendedor

Compraventa "1" *-- "1..*" DetalleCompraventa : contiene

Producto "1" -- "0..*" DetalleCompraventa : producto

Oferta "0..1" -- "0..*" DetalleCompraventa : oferta aplicada


' =========================================================
' RELACIONES DE NOTIFICACIONES
' =========================================================

Usuario "1" -- "0..*" Notificacion : destinatario

Usuario "0..1" -- "0..*" Notificacion : emisor

Producto "0..1" -- "0..*" Notificacion : producto relacionado

Oferta "0..1" -- "0..*" Notificacion : oferta relacionada


' =========================================================
' REGLAS DEL MODELO
' =========================================================

note bottom of Producto
  Un producto puede comprarse cuando:
  - estado = ACTIVO
  - cantidadDisponible > 0

  Si cantidadDisponible = 0,
  el producto está agotado, no bloqueado.

  BLOQUEADO representa un bloqueo
  administrativo.
end note

note bottom of Oferta
  La oferta es opcional y temporal.

  Mientras esté activa, puede aplicarse
  precioOferta en lugar de precioBase.

  El producto puede comprarse aunque
  no tenga ninguna oferta.
end note

note bottom of LineaCarrito
  Añadir un producto al carrito
  no reserva ni bloquea sus unidades.

  idOferta es opcional porque el producto
  puede añadirse sin una oferta activa.

  La disponibilidad debe comprobarse
  antes de realizar la compraventa.
end note

note bottom of DetalleCompraventa
  precioUnitarioFinal conserva el precio
  definitivo de la operación.

  Puede coincidir con:
  - Producto.precioBase
  - Oferta.precioOferta
  - Otro precio acordado

  idOferta es opcional.

  No se almacena el proceso
  de negociación.
end note

note bottom of Notificacion
  idEmisor puede ser nulo cuando la
  notificación la genera el sistema.

  idProducto e idOferta son opcionales
  porque no todas las notificaciones
  están relacionadas con ellos.
end note

@enduml
