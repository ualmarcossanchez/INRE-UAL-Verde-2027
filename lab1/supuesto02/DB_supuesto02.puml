@startuml

left to right direction

skinparam shadowing false
skinparam linetype ortho

skinparam entity {
    BackgroundColor White
    BorderColor Black
}

title Modelo relacional - Sistema de Compras

' =========================================================
' USUARIOS Y ROLES
' =========================================================

entity USUARIO {
    * idUsuario : int <<PK>>
    --
    * nombre : varchar
    * email : varchar
    * passwordHash : varchar
    * fechaRegistro : datetime
    * activo : boolean
}

entity ROL {
    * idRol : int <<PK>>
    --
    * nombre : varchar
}

entity USUARIO_ROL {
    * idUsuario : int <<PK, FK>>
    * idRol : int <<PK, FK>>
}

' =========================================================
' PRODUCTOS Y OFERTAS
' =========================================================

entity PRODUCTO {
    * idProducto : int <<PK>>
    --
    * idVendedor : int <<FK>>
    * nombre : varchar
    descripcion : varchar
    * precioBase : decimal
    * cantidadDisponible : int
    * estado : EstadoProducto
    * fechaAlta : datetime
}

entity OFERTA {
    * idOferta : int <<PK>>
    --
    * idProducto : int <<FK>>
    * idPublicador : int <<FK>>
    * precioOferta : decimal
    * fechaInicio : datetime
    * fechaFin : datetime
    * estado : EstadoOferta
}

' =========================================================
' CARRITO
' =========================================================

entity CARRITO {
    * idCarrito : int <<PK>>
    --
    * idComprador : int <<FK>>
    * fechaCreacion : datetime
    * estado : EstadoCarrito
}

entity LINEA_CARRITO {
    * idLinea : int <<PK>>
    --
    * idCarrito : int <<FK>>
    * idProducto : int <<FK>>
    idOferta : int <<FK>>
    * cantidad : int
    * fechaAgregacion : datetime
}

' =========================================================
' COMPRAVENTAS
' =========================================================

entity COMPRAVENTA {
    * idCompraventa : int <<PK>>
    --
    * idComprador : int <<FK>>
    * idVendedor : int <<FK>>
    * fecha : datetime
    * estado : EstadoCompraventa
    * importeTotal : decimal
}

entity DETALLE_COMPRAVENTA {
    * idDetalle : int <<PK>>
    --
    * idCompraventa : int <<FK>>
    * idProducto : int <<FK>>
    idOferta : int <<FK>>
    * cantidad : int
    * precioUnitarioFinal : decimal
}

' =========================================================
' NOTIFICACIONES
' =========================================================

entity NOTIFICACION {
    * idNotificacion : int <<PK>>
    --
    * idDestinatario : int <<FK>>
    idEmisor : int <<FK>>
    idProducto : int <<FK>>
    idOferta : int <<FK>>
    * titulo : varchar
    * mensaje : varchar
    * tipo : TipoNotificacion
    * fechaCreacion : datetime
    fechaLectura : datetime
    * leida : boolean
}

' =========================================================
' RELACIONES: USUARIOS Y ROLES
' =========================================================

USUARIO ||--o{ USUARIO_ROL : tiene
ROL ||--o{ USUARIO_ROL : asignado

' =========================================================
' RELACIONES: PRODUCTOS Y OFERTAS
' =========================================================

USUARIO ||--o{ PRODUCTO : vende
PRODUCTO ||--o{ OFERTA : tiene
USUARIO ||--o{ OFERTA : publica

' =========================================================
' RELACIONES: CARRITO
' =========================================================

USUARIO ||--o{ CARRITO : posee
CARRITO ||--o{ LINEA_CARRITO : contiene
PRODUCTO ||--o{ LINEA_CARRITO : aparece_en
OFERTA |o--o{ LINEA_CARRITO : aplicada_en

' =========================================================
' RELACIONES: COMPRAVENTAS
' =========================================================

USUARIO ||--o{ COMPRAVENTA : compra
USUARIO ||--o{ COMPRAVENTA : vende

COMPRAVENTA ||--|{ DETALLE_COMPRAVENTA : contiene
PRODUCTO ||--o{ DETALLE_COMPRAVENTA : aparece_en
OFERTA |o--o{ DETALLE_COMPRAVENTA : aplicada_en

' =========================================================
' RELACIONES: NOTIFICACIONES
' =========================================================

USUARIO ||--o{ NOTIFICACION : recibe
USUARIO |o--o{ NOTIFICACION : emite
PRODUCTO |o--o{ NOTIFICACION : relacionada_con
OFERTA |o--o{ NOTIFICACION : relacionada_con

' =========================================================
' DOMINIOS DE LOS ATRIBUTOS ENUMERADOS
' =========================================================

legend right
    |= Dominio |= Valores permitidos |
    | EstadoProducto | ACTIVO, BLOQUEADO, ELIMINADO |
    | EstadoOferta | PENDIENTE, ACTIVA, FINALIZADA, CANCELADA, ELIMINADA |
    | EstadoCarrito | ACTIVO, CONFIRMADO, CANCELADO |
    | EstadoCompraventa | PENDIENTE, ACEPTADA, RECHAZADA, CANCELADA, COMPLETADA |
    | TipoNotificacion | NUEVO_PRODUCTO, NUEVA_OFERTA, FIN_OFERTA, OFERTA_ELIMINADA, COMPRAVENTA, SISTEMA |
endlegend

' =========================================================
' RESTRICCIONES: USUARIO_ROL
' =========================================================

note right of USUARIO_ROL
    Clave primaria compuesta:
    PK (idUsuario, idRol)

    FK idUsuario
        references USUARIO(idUsuario)

    FK idRol
        references ROL(idRol)
end note

' =========================================================
' RESTRICCIONES: PRODUCTO
' =========================================================

note right of PRODUCTO
    FK idVendedor
        references USUARIO(idUsuario)

    cantidadDisponible >= 0
    precioBase >= 0

    Un producto puede comprarse si:
    - estado = ACTIVO
    - cantidadDisponible > 0

    cantidadDisponible = 0 significa
    que el producto está agotado,
    no bloqueado.

    BLOQUEADO representa un bloqueo
    administrativo.
end note

' =========================================================
' RESTRICCIONES: OFERTA
' =========================================================

note right of OFERTA
    FK idProducto
        references PRODUCTO(idProducto)

    FK idPublicador
        references USUARIO(idUsuario)

    precioOferta >= 0
    fechaFin > fechaInicio

    La oferta es opcional y temporal.

    Mientras esté activa, puede utilizarse
    precioOferta en lugar de precioBase.

    El producto puede comprarse aunque
    no tenga ninguna oferta activa.
end note

' =========================================================
' RESTRICCIONES: LINEA_CARRITO
' =========================================================

note right of LINEA_CARRITO
    FK idCarrito
        references CARRITO(idCarrito)

    FK idProducto
        references PRODUCTO(idProducto)

    FK idOferta
        references OFERTA(idOferta)

    idOferta admite NULL.
    cantidad > 0.

    Añadir un producto al carrito
    reserva y bloquea unidades (se resta cantidad disponible).

    La disponibilidad se comprueba
    antes de crear la compraventa.
end note

' =========================================================
' RESTRICCIONES: COMPRAVENTA
' =========================================================

note right of COMPRAVENTA
    FK idComprador
        references USUARIO(idUsuario)

    FK idVendedor
        references USUARIO(idUsuario)

    importeTotal >= 0

    idComprador e idVendedor deben
    referirse a usuarios diferentes.
end note

' =========================================================
' RESTRICCIONES: DETALLE_COMPRAVENTA
' =========================================================

note right of DETALLE_COMPRAVENTA
    FK idCompraventa
        references COMPRAVENTA(idCompraventa)

    FK idProducto
        references PRODUCTO(idProducto)

    FK idOferta
        references OFERTA(idOferta)

    idOferta admite NULL.
    cantidad > 0.
    precioUnitarioFinal >= 0.

    precioUnitarioFinal conserva
    el precio definitivo de la operación.

    Puede coincidir con:
    - PRODUCTO.precioBase
    - OFERTA.precioOferta
    - otro precio acordado

    No se almacena el proceso
    de negociación.
end note

' =========================================================
' RESTRICCIONES: NOTIFICACION
' =========================================================

note right of NOTIFICACION
    FK idDestinatario
        references USUARIO(idUsuario)

    FK idEmisor
        references USUARIO(idUsuario)

    FK idProducto
        references PRODUCTO(idProducto)

    FK idOferta
        references OFERTA(idOferta)

    idEmisor admite NULL cuando
    la notificación procede del sistema.

    idProducto e idOferta admiten NULL
    porque no todas las notificaciones
    están relacionadas con ellos.

    fechaLectura admite NULL mientras
    la notificación no haya sido leída.
end note

@enduml
